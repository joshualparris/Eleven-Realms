{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Eleven-Realms mission contract",
  "type": "object",
  "required": ["id", "title", "objective", "owned_paths", "readable_paths", "forbidden_paths", "dependencies", "acceptance", "required_tests", "reviewer", "complexity"],
  "properties": {
    "id": { "type": "string", "pattern": "^ER-[0-9]{3}$" },
    "title": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "owned_paths": { "type": "array", "items": { "type": "string" } },
    "readable_paths": { "type": "array", "items": { "type": "string" } },
    "forbidden_paths": { "type": "array", "items": { "type": "string" } },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "acceptance": { "type": "array", "items": { "type": "string" } },
    "required_tests": { "type": "array", "items": { "type": "string" } },
    "reviewer": { "type": "string", "minLength": 1 },
    "complexity": { "type": "string", "enum": ["low", "medium", "high"] },
    "round": { "type": "string" },
    "mode": { "type": "string" }
  },
  "additionalProperties": false
}
